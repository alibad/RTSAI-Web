{
  "name": "rtsai-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.0 <23",
    "npm": "11.19.x"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "vercel-build": "vite build",
    "start": "vinext start",
    "sync:game-media": "node scripts/sync-game-media.mjs",
    "sync:content": "node scripts/sync-content-catalog.mjs",
    "check:content": "node scripts/sync-content-catalog.mjs --check",
    "sync:release": "node scripts/sync-release-manifest.mjs",
    "sync:mod-release": "node scripts/sync-mod-release.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run check:content && npm run typecheck && npm run build && node --import tsx --test tests/*.test.*",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vercel"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "fflate": "^0.8.2",
    "firebase": "^12.17.1",
    "jose": "^6.2.8",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.10.0",
    "nitro": "^3.0.260610-beta",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  },
  "type": "module"
}
