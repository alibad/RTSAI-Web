rules_version = '2';

// rtsai-net Firestore. Browsers (signed in, never anonymous) may only touch the paths below. Everything else,
// including the hosted AI's aiInstalls / aiUsage / aiSpend documents, stays server-only (service account).
service cloud.firestore {
  match /databases/{database}/documents {
    function member() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function soon(t) {
      return t is timestamp && t > request.time && t < request.time + duration.value(2, 'h');
    }

    // ---- Usage counters (lib/player-stats.ts): exactly one counter goes up by exactly 1 per write.
    function changed() {
      return resource == null ? request.resource.data.keys().toSet() : request.resource.data.diff(resource.data).affectedKeys();
    }
    function up(f) {
      return !changed().hasAny([f]) || request.resource.data.get(f, 0) == (resource == null ? 0 : resource.data.get(f, 0)) + 1;
    }
    match /players/{uid} {
      allow read: if member() && request.auth.uid == uid;
      allow create, update: if member() && request.auth.uid == uid
        && changed().hasOnly(['joined', 'matches', 'multiplayer', 'aiAssists', 'errors', 'lastSeen'])
        && changed().difference(['lastSeen'].toSet()).size() == 1
        && up('joined') && up('matches') && up('multiplayer') && up('aiAssists') && up('errors')
        && request.resource.data.lastSeen == request.time;
    }
    match /stats/global {
      allow read: if member();
      allow create, update: if member()
        && changed().hasOnly(['players', 'matches', 'multiplayer', 'aiAssists']) && changed().size() == 1
        && up('players') && up('matches') && up('multiplayer') && up('aiAssists');
    }

    // ---- Matchmaking for direct multiplayer (RTSAI-WebGame web/src/net/matchmaker.ts). Only introductions:
    // a guest's WebRTC offer and the host's answer. Clients delete them once used (TTL needs a paid plan).
    match /p2pMatches/{code} {
      function host() { return get(/databases/$(database)/documents/p2pMatches/$(code)).data.host; }
      allow get: if member();
      allow list, update: if false;
      allow create: if member() && code.matches('^[A-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['host', 'version', 'expires'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.version is string && request.resource.data.version.size() <= 300
        && soon(request.resource.data.expires);
      allow delete: if member() && resource.data.host == request.auth.uid;

      match /joins/{joinId} {
        allow create: if member() && exists(/databases/$(database)/documents/p2pMatches/$(code))
          && request.resource.data.keys().hasOnly(['guest', 'offer', 'expires'])
          && request.resource.data.guest == request.auth.uid
          && request.resource.data.offer is string && request.resource.data.offer.size() <= 24000
          && soon(request.resource.data.expires);
        allow get: if member() && (resource.data.guest == request.auth.uid || host() == request.auth.uid);
        allow list: if member() && host() == request.auth.uid;
        allow update: if member() && host() == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer'])
          && request.resource.data.answer is string && request.resource.data.answer.size() <= 24000;
        allow delete: if member() && (resource.data.guest == request.auth.uid || host() == request.auth.uid);
      }
    }

    // ---- Saved maps: Earth battlefields from the studio (lib/saved-maps.ts writes; RTSAI-WebGame web/src/net/saved-maps.ts
    // reads). maps/{id} is what a list shows, mapData/{id} the map itself; both are created in one commit. Any member
    // reads one by id (a host's guests fetch the match's map); only its owner lists, renames or deletes theirs.
    function savedMap(d) {
      return d.keys().hasOnly(['owner', 'mapId', 'title', 'place', 'latitude', 'longitude', 'radius', 'seed', 'size', 'players', 'preview', 'created'])
        && d.keys().hasAll(['owner', 'mapId', 'title', 'place', 'latitude', 'longitude', 'radius', 'seed', 'size', 'players', 'preview', 'created'])
        && d.mapId is string && d.mapId.matches('^earth-[a-f0-9]{16}$')
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.place is string && d.place.size() <= 120
        && d.latitude is number && d.latitude >= -85 && d.latitude <= 85
        && d.longitude is number && d.longitude >= -180 && d.longitude <= 180
        && d.radius is int && d.radius >= 500 && d.radius <= 10000
        && d.seed is int && d.seed >= 0 && d.seed <= 2147483647
        && d.size in [48, 64, 80] && d.players in [2, 4]
        && d.preview is bytes && d.preview.size() > 0 && d.preview.size() <= 131072;
    }
    match /maps/{mapDoc} {
      allow get: if member();
      allow list: if member() && resource.data.owner == request.auth.uid;
      allow create: if member() && mapDoc.matches('^[A-Za-z0-9]{20}$')
        && savedMap(request.resource.data)
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.created == request.time
        && getAfter(/databases/$(database)/documents/mapData/$(mapDoc)).data.mapId == request.resource.data.mapId;
      allow update: if member() && resource.data.owner == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80;
      allow delete: if member() && resource.data.owner == request.auth.uid;
    }
    // map.yaml and map.bin; the largest map (80 × 160 cells) has a 76,817-byte map.bin.
    match /mapData/{mapDoc} {
      allow get: if member();
      allow list, update: if false;
      allow create: if member() && mapDoc.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.keys().hasOnly(['owner', 'mapId', 'yaml', 'bin'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.mapId is string && request.resource.data.mapId.matches('^earth-[a-f0-9]{16}$')
        && request.resource.data.yaml is string && request.resource.data.yaml.size() > 0 && request.resource.data.yaml.size() <= 8192
        && request.resource.data.bin is bytes && request.resource.data.bin.size() > 17 && request.resource.data.bin.size() <= 76817
        && getAfter(/databases/$(database)/documents/maps/$(mapDoc)).data.owner == request.auth.uid;
      allow delete: if member() && resource.data.owner == request.auth.uid;
    }

    // ---- Outgoing mail (lib/firebase-mail.ts): our sendMail function (functions/index.js, the Trigger Email contract) delivers
    // each new mail/{id} over SMTP and writes its delivery state back. Create-only, in the extension's exact shape
    // and sizes, and only to the team group: a signed-in or anonymous caller can never mail anyone else through it.
    match /mail/{mailId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['to', 'message'])
        && request.resource.data.to == ['rtsai@googlegroups.com']
        && request.resource.data.message is map
        && request.resource.data.message.keys().hasOnly(['subject', 'html', 'text'])
        && request.resource.data.message.subject is string && request.resource.data.message.subject.size() < 200
        && request.resource.data.message.html is string && request.resource.data.message.html.size() < 32768
        && request.resource.data.message.text is string && request.resource.data.message.text.size() < 32768;
      allow read, update, delete: if false;
    }

    // ---- Team admins: a doc at admins/{uid}, written only from the Firebase console.
    function admin() {
      return member() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{uid} {
      allow read, write: if false;
    }

    // ---- Feedback files (RTSAI-Web app/components/feedback/report-files.ts, shared with the game). The reporter's
    // browser writes a report, its files' bytes in chunks of at most 900 KiB, then each file's record; create only,
    // within 30 minutes of the report. Nobody but an admin can read or list them (the site's /feedback/<id> viewer).
    match /feedbackReports/{reportId} {
      function report() { return get(/databases/$(database)/documents/feedbackReports/$(reportId)).data; }
      function writable() {
        return member() && report().owner == request.auth.uid && request.time < report().created + duration.value(30, 'm');
      }
      function chunkExists(fileId, index) {
        return exists(/databases/$(database)/documents/feedbackReports/$(reportId)/chunks/$(fileId + '_' + string(index)));
      }
      allow read: if admin();
      allow create: if member()
        && reportId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')
        && request.resource.data.keys().hasOnly(['owner', 'created', 'source'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.created == request.time
        && request.resource.data.source in ['web', 'game'];
      allow update, delete: if false;

      // {fileId}_{index}: at most 12 chunks (10 MiB), each written once.
      match /chunks/{chunkId} {
        allow read: if admin();
        allow create: if writable()
          && chunkId.matches('^[a-z0-9]{16}_([0-9]|1[01])$')
          && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is bytes
          && request.resource.data.data.size() > 0 && request.resource.data.data.size() <= 921600;
        allow update, delete: if false;
      }

      // Written last: the record of a whole file, whose first and last chunks must already be there.
      match /files/{fileId} {
        allow read: if admin();
        allow create: if writable()
          && fileId.matches('^[a-z0-9]{16}$')
          && request.resource.data.keys().hasOnly(['name', 'kind', 'contentType', 'bytes', 'chunks', 'durationSeconds', 'created'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
          && request.resource.data.kind in ['screenshot', 'voice', 'file']
          && request.resource.data.contentType in ['image/png', 'image/jpeg', 'image/webp', 'image/gif', 'video/webm', 'video/mp4',
            'video/quicktime', 'audio/webm', 'audio/ogg', 'audio/mpeg', 'audio/mp4', 'audio/x-m4a', 'audio/aac', 'audio/wav',
            'audio/x-wav', 'text/plain', 'text/markdown', 'text/csv', 'application/json']
          && (request.resource.data.kind != 'screenshot' || request.resource.data.contentType.matches('image/.*'))
          && (request.resource.data.kind != 'voice' || request.resource.data.contentType.matches('audio/.*'))
          && request.resource.data.bytes is int && request.resource.data.bytes > 0 && request.resource.data.bytes <= 10485760
          && request.resource.data.chunks is int && request.resource.data.chunks >= 1 && request.resource.data.chunks <= 12
          && (request.resource.data.chunks - 1) * 921600 < request.resource.data.bytes
          && request.resource.data.bytes <= request.resource.data.chunks * 921600
          && (!('durationSeconds' in request.resource.data) || (request.resource.data.durationSeconds is int
            && request.resource.data.durationSeconds >= 0 && request.resource.data.durationSeconds <= 600))
          && request.resource.data.created == request.time
          && chunkExists(fileId, 0) && chunkExists(fileId, request.resource.data.chunks - 1);
        allow update, delete: if false;
      }
    }
  }
}
