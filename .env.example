NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-web-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Server-only private feedback inbox. Never prefix these with NEXT_PUBLIC_.
NEXT_PUBLIC_APP_URL=https://rtsai.net
FEEDBACK_ALLOWED_ORIGINS=https://rtsai.net,https://www.rtsai.net

# Existing Firebase project running the official Trigger Email extension.
# SMTP credentials remain in Firebase Secret Manager and never enter this app.
MAIL_FIREBASE_PROJECT_ID=your-mail-project-id
MAIL_FIREBASE_API_KEY=your-mail-project-web-api-key
MAIL_GROUP=private-mail-archive@example.com
FEEDBACK_ADMIN_EMAIL=builder@example.com

# GitHub App installation with Issues: read/write access to the private web repo.
# Use an App installation token, never a personal access token.
GITHUB_APP_ID=123456
GITHUB_APP_INSTALLATION_ID=12345678
GITHUB_APP_PRIVATE_KEY=base64-encoded-github-app-private-key
GITHUB_REPO_OWNER=your-github-owner
GITHUB_REPO_NAME=your-private-web-repository

# Hosted AI co-commander proxy (/api/ai/v1/*). Server-only: never prefix with NEXT_PUBLIC_.
# Required to serve requests:
ANTHROPIC_API_KEY=
# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
RTSAI_AI_TOKEN_SECRET=
# Firebase service-account JSON key (raw JSON or base64) with the Cloud Datastore User role.
RTSAI_AI_FIREBASE_SERVICE_ACCOUNT=
# Optional (defaults in lib/hosted-ai/config.ts):
# RTSAI_AI_STORE=                     # firestore (default on Vercel) or memory (local only; refused in production)
# RTSAI_AI_KILL_SWITCH=               # 1 pauses every model call with HTTP 503 service_paused
# RTSAI_AI_ANON_DAILY_USD=            # per-install daily allowance, default 0.25
# RTSAI_AI_LINKED_DAILY_USD=          # allowance after linking an rtsai.net account, default 1.00
# RTSAI_AI_GLOBAL_DAILY_CAP_USD=      # whole-service daily spend cap, default 10
# RTSAI_AI_REQUESTS_PER_MINUTE=       # per install token, default 12
# RTSAI_AI_INSTALLS_PER_IP_PER_DAY=   # new install tokens per client IP, default 5
# RTSAI_AI_MAX_TOKENS=                # output clamp, default 1024
# RTSAI_AI_MAX_IMAGES=                # default 2
# RTSAI_AI_MAX_IMAGE_BYTES=           # per decoded image, default 400000
# RTSAI_AI_MAX_TOTAL_IMAGE_BYTES=     # per request, default 600000
# RTSAI_AI_MAX_BODY_BYTES=            # default 2000000; hard ceiling 4000000 (Vercel limit is 4.5 MB)
# RTSAI_AI_UPSTREAM_TIMEOUT_MS=       # default 15000
# Local rehearsal only: ANTHROPIC_BASE_URL=http://127.0.0.1:4787 with `node scripts/mock-anthropic.mjs`.
